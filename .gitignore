# secrets
.env
.env.*
!.env.example

# macOS
.DS_Store

# mise per-machine overrides
.mise.local.toml
mise.local.toml

# raw event logs from live runs; the fixtures are tracked (Messages streams
# under sse/, Managed Agents session streams under sessions/)
*.sse
!tests/fixtures/sse/*.sse
!tests/fixtures/sessions/**/*.sse

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt
