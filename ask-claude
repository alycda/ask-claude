#!/usr/bin/env -S usage bash
#USAGE about "chat loop (messages api); /new resets, /quit exits"
#USAGE unknown_flags "error"
#USAGE arg "[prompt]" help="one shot, prints the response"
#USAGE flag "-m --model <model>" help="a full model id (see https://platform.claude.com/docs/en/api/cli/models/list)" default="claude-opus-5-5" global=#true
#USAGE flag "-e --effort <effort>" help="how hard the model thinks" default="medium" global=#true {
#USAGE   choices "low" "medium" "high" "xhigh" "max"
#USAGE }
#USAGE flag "-S --system <system>" help="system prompt" global=#true
#USAGE flag "-s --skills <skills>" help="comma-separated <skill_id>[@<version>]" global=#true
#USAGE flag "-f --file <file>" help="prepend this file's contents to the prompt" global=#true
#USAGE flag "-p --provider <provider>" help="anthropic|openai; only anthropic is implemented in bash" default="anthropic" global=#true
#USAGE flag "--base-url <url>" help="API root, e.g. https://api.venice.ai/api/v1 for Venice; defaults per provider" global=#true
#USAGE flag "--max-tokens <n>" help="cap on output tokens per reply" default="16000" global=#true
#USAGE flag "--web" help="let the model search and fetch the web (server tools; searches cost extra)" global=#true
#USAGE flag "--mcp <url>" help="an MCP server (https) the model may call; repeatable; its token in ASK_CLAUDE_MCP_TOKEN_<HOST>, or ASK_CLAUDE_MCP_TOKEN for a lone server" var=#true global=#true
#USAGE flag "--mcp-tool <host:tool>" help="only these tools of that --mcp server, e.g. mcp.example.com:search; repeatable; a server not named keeps all its tools" var=#true global=#true
#USAGE flag "--advisor <model>" help="a model the reply may consult mid-turn (server tool, at most 3 calls a turn, billed at that model's rates); must be at least as capable as -m" global=#true
#USAGE flag "-V --version" help="print the version"
#USAGE cmd "list" help="chats on disk, newest first"
#USAGE cmd "resume" help="continue a chat" {
#USAGE   arg "[chat]" help="chat name or unique prefix; newest chat if omitted"
#USAGE }
#USAGE cmd "agent" help="a Managed Agents session: one shot with a prompt, a chat without" {
#USAGE   arg "[prompt]" help="one shot in a new session"
#USAGE   flag "--agent <id>" help="agent id from the Console" env="ASK_CLAUDE_AGENT" global=#true
#USAGE   flag "--environment <id>" help="environment id from the Console" env="ASK_CLAUDE_ENVIRONMENT" global=#true
#USAGE   flag "--budget <cents>" help="spend cap for the session at list price; 0 for none" default="100" global=#true
#USAGE   flag "--vault <id>" help="vault of credentials to attach; repeatable" var=#true global=#true
#USAGE   flag "--repo <url>" help="GitHub repository to mount, owner/name[@branch]; GITHUB_TOKEN" global=#true
#USAGE   flag "--memory <id>" help="memory store to attach, <id>[:ro]; repeatable, up to 8" var=#true global=#true
#USAGE   flag "--force" help="files: overwrite what exists" global=#true
#USAGE   flag "--local-mcp <command>" help="a stdio MCP server on this machine that answers the agent's custom tools, e.g. 'tb --mcp'" env="ASK_CLAUDE_LOCAL_MCP" global=#true
#USAGE   cmd "list" help="sessions, newest first"
#USAGE   cmd "tools" help="the --local-mcp server's tools as custom tool definitions, for the agent"
#USAGE   cmd "resume" help="continue a session" {
#USAGE     arg "<session>" help="session id or unique prefix"
#USAGE   }
#USAGE   cmd "files" help="what the agent wrote; download the named ones" {
#USAGE     arg "<session>"
#USAGE     arg "[name]..." help="files to download into the current directory" var=#true
#USAGE   }
#USAGE   cmd "budget" help="change the spend cap of a session" {
#USAGE     arg "<session>"
#USAGE     arg "<cents>" help="new cap at list price; 0 removes it, for good"
#USAGE   }
#USAGE   cmd "archive" help="archive an idle session" {
#USAGE     arg "<session>"
#USAGE   }
#USAGE   cmd "trace" help="print the Console URL of a session" {
#USAGE     arg "<session>"
#USAGE   }
#USAGE }
# shellcheck shell=bash
# shellcheck disable=SC2154  # usage_* vars are set by the usage runtime
# shellcheck source-path=SCRIPTDIR/lib  # the modules: . "$LIB/<name>.bash"

set -uo pipefail
# The script carries its own copy of VERSION, read by --version below;
# `just bump` rewrites this line and `just check-version-line` compares them.
readonly ASK_CLAUDE_VERSION=0.3.1
# History holds whole conversations, including -f file contents: every file
# and directory this script creates is private to the user, whatever the
# shell's umask.
umask 077

# The jq programs and the bash modules live next to the script, in lib/
# (docs/plan.md: one shape for the goldens, the bash script and the Rust
# port; each module's header names the globals it reads and sets).
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ask-claude"

die() {
  echo "ask-claude: $*" >&2
  exit 2
}

# -V/--version: print and stop, before anything else is checked.
if [ "${usage_version:-}" = true ]; then
  echo "ask-claude $ASK_CLAUDE_VERSION"
  exit 0
fi

# The modules, in the order the single file had them: config runs the
# flag and state-dir checks, the rest define state and functions. The
# script runs without -e, so a missing module is caught here, not as
# "command not found" later.
for _mod in config common chat messages local-mcp agent-api agent-turn; do
  [ -r "$LIB/$_mod.bash" ] || die "missing $LIB/$_mod.bash; the script needs every file in lib/"
done
. "$LIB/config.bash"
. "$LIB/common.bash"
. "$LIB/chat.bash"
. "$LIB/messages.bash"
. "$LIB/local-mcp.bash"
. "$LIB/agent-api.bash"
. "$LIB/agent-turn.bash"

case "${usage_cmd:-}" in
agent)
  session_prereqs
  session_file_id=""
  if [ -n "${usage_file:-}" ]; then session_file_id=$(file_upload "$usage_file") || exit 1; fi
  if [ -z "${usage_prompt:-}" ]; then
    session_loop
    exit 0
  fi
  sesn=$(session_create "$usage_prompt") || exit 1
  if session_turn "$sesn"; then
    session_remember "$sesn"
    exit 0
  fi
  exit 1
  ;;
"agent files")
  need_key
  sesn=$(session_find "$usage_session") || exit 2
  set -f # usage joins the names with spaces: no globbing on them (a name with a space is two names)
  # shellcheck disable=SC2086  # usage_name is the space-joined list usage builds
  session_files "$sesn" ${usage_name:-} || exit 1
  exit 0
  ;;
"agent budget")
  sesn=$(session_find "$usage_session") || exit 2
  session_budget "$sesn" "$usage_cents" || exit 1
  exit 0
  ;;
"agent archive")
  sesn=$(session_find "$usage_session") || exit 2
  session_archive "$sesn" || exit 1
  exit 0
  ;;
"agent trace")
  sesn=$(session_find "$usage_session") || exit 2
  echo "https://platform.claude.com/workspaces/${ASK_CLAUDE_WORKSPACE:-default}/sessions/$sesn"
  exit 0
  ;;
"agent list")
  need_key
  session_list
  exit 0
  ;;
"agent tools")
  # no key, agent or environment: this only asks the local server. The
  # top-level $schema some servers send (Supabase's, Cloudflare's) is
  # dropped: a JSON Schema meta key the agent's tool definition does not need.
  [ -n "${usage_local_mcp:-}" ] || die "agent tools needs --local-mcp <command> (or ASK_CLAUDE_LOCAL_MCP)"
  trap local_mcp_stop EXIT
  local_mcp_start "$usage_local_mcp"
  jq '[.[] | {type: "custom", name, description: (.description // .title // .name),
              input_schema: (.inputSchema // {type: "object", properties: {}} | del(."$schema"))}]' <<<"$LOCAL_MCP_TOOLS"
  exit 0
  ;;
"agent resume")
  sesn=$(session_find "$usage_session") || exit 2
  session_prereqs
  echo "resuming $sesn" >&2
  session_history "$sesn" >&2
  session_loop "$sesn"
  exit 0
  ;;
list)
  list_chats
  exit 0
  ;;
resume)
  HIST=$(find_chat "${usage_chat:-}") || exit 2
  need_key
  echo "resuming $HIST" >&2
  show_history >&2
  chat_loop
  exit $?
  ;;
esac

# no prompt: the chat loop
if [ -z "${usage_prompt:-}" ]; then
  need_key
  HIST=$(new_chat)
  echo '[]' >"$HIST"
  chat_loop
  exit $?
fi

# one shot: optional -f FILE, then the prompt
need_key
prefix=""
if [ -n "${usage_file:-}" ]; then
  [ -r "$usage_file" ] || die "cannot read $usage_file"
  prefix="$(cat "$usage_file")"$'\n\n'
fi
HIST="$(new_chat)"
echo '[]' >"$HIST"
ask "$prefix$usage_prompt"
rc=$?
# an empty chat leaves no file
[ "$(jq length "$HIST")" -gt 0 ] || rm -f "$HIST"
exit $rc
