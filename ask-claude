#!/usr/bin/env -S usage bash
#USAGE about "chat loop; /new resets, /quit exits"
#USAGE unknown_flags "error"
#USAGE arg "[prompt]" help="one shot, prints the response"
#USAGE flag "-m --model <model>" help="haiku, sonnet, opus, fable, or a full model id" default="claude-opus-5-5" global=#true
#USAGE flag "-e --effort <effort>" help="how hard the model thinks" default="medium" global=#true {
#USAGE   choices "low" "medium" "high" "xhigh" "max"
#USAGE }
#USAGE flag "-S --system <system>" help="system prompt" global=#true
#USAGE flag "-s --skills <skills>" help="comma-separated <skill_id>[@<version>]" global=#true
#USAGE flag "-f --file <file>" help="prepend this file's contents to the prompt" global=#true
#USAGE flag "-p --provider <provider>" help="anthropic|openai; only anthropic is implemented in bash" default="anthropic" global=#true
#USAGE flag "--base-url <url>" help="API root, e.g. https://api.venice.ai/api/v1 for Venice; defaults per provider" global=#true
#USAGE flag "--max-tokens <n>" help="cap on output tokens per reply" default="16000" global=#true
#USAGE flag "-V --version" help="print the version"
#USAGE cmd "list" help="chats on disk, newest first"
#USAGE cmd "resume" help="continue a chat" {
#USAGE   arg "[chat]" help="chat name or unique prefix; newest chat if omitted"
#USAGE }
#USAGE cmd "agent" help="a Managed Agents session: one shot with a prompt, a chat without" {
#USAGE   arg "[prompt]" help="one shot in a new session"
#USAGE   flag "--agent <id>" help="agent id from the Console" env="ASK_CLAUDE_AGENT" global=#true
#USAGE   flag "--environment <id>" help="environment id from the Console" env="ASK_CLAUDE_ENVIRONMENT" global=#true
#USAGE   flag "--budget <cents>" help="spend cap for the session at list price; 0 for none" default="100" global=#true
#USAGE   flag "--vault <id>" help="vault of credentials to attach; repeatable" var=#true global=#true
#USAGE   flag "--repo <url>" help="GitHub repository to mount, owner/name[@branch]; GITHUB_TOKEN" global=#true
#USAGE   flag "--memory <id>" help="memory store to attach, <id>[:ro]; repeatable, up to 8" var=#true global=#true
#USAGE   flag "--force" help="files: overwrite what exists" global=#true
#USAGE   cmd "list" help="sessions, newest first"
#USAGE   cmd "resume" help="continue a session" {
#USAGE     arg "<session>" help="session id or unique prefix"
#USAGE   }
#USAGE   cmd "files" help="what the agent wrote; download the named ones" {
#USAGE     arg "<session>"
#USAGE     arg "[name]..." help="files to download into the current directory" var=#true
#USAGE   }
#USAGE   cmd "budget" help="change the spend cap of a session" {
#USAGE     arg "<session>"
#USAGE     arg "<cents>" help="new cap at list price; 0 removes it, for good"
#USAGE   }
#USAGE   cmd "archive" help="archive an idle session" {
#USAGE     arg "<session>"
#USAGE   }
#USAGE   cmd "trace" help="print the Console URL of a session" {
#USAGE     arg "<session>"
#USAGE   }
#USAGE }
# shellcheck shell=bash
# shellcheck disable=SC2154  # usage_* vars are set by the usage runtime

set -uo pipefail
# The script ships as one file, so it carries its own copy of VERSION;
# `just bump` rewrites this line and `just check-version-line` compares them.
readonly ASK_CLAUDE_VERSION=0.2.1
# History holds whole conversations, including -f file contents: every file
# and directory this script creates is private to the user, whatever the
# shell's umask.
umask 077

# The jq programs live next to the script, in lib/ (docs/plan.md: one shape
# for the goldens, the bash script and the Rust port).
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/ask-claude"

die() {
  echo "ask-claude: $*" >&2
  exit 2
}

# -V/--version: print and stop, before anything else is checked.
if [ "${usage_version:-}" = true ]; then
  echo "ask-claude $ASK_CLAUDE_VERSION"
  exit 0
fi

# agent: declared for docs/plans/2026-11-05-001; refused until each piece is
# built. The commit that builds one deletes its line (and its test in
# tests/unit/refuse.bats).
not_built() { die "$* is not implemented in ask-claude $ASK_CLAUDE_VERSION, see docs/plans/2026-11-05-001-feat-managed-agents-sessions-plan.md"; }
case "${usage_cmd:-}" in
"agent budget" | "agent archive" | "agent trace") not_built "$usage_cmd" ;; # U10
esac

# Providers. The bash version speaks the Messages API only; the OpenAI
# chat-completions shape (OpenAI, Venice at its own base URL) is the Rust
# port's (docs/plan.md, phase 3). Refused before any key check or request.
case "${usage_provider:-anthropic}" in
anthropic) ;;
openai) die "--provider openai is not implemented in the bash version, see docs/plan.md" ;;
*) die "unknown provider \"$usage_provider\" (anthropic|openai)" ;;
esac

# --base-url: the API root, https://api.anthropic.com unless given. Anything
# but https goes to a loopback address only, so the key never travels in
# clear over a network.
BASE_URL="${usage_base_url:-https://api.anthropic.com}"
case "$BASE_URL" in
https://*) ;;
http://localhost | http://localhost[:/]* | http://127.0.0.1 | http://127.0.0.1[:/]* | http://\[::1\] | http://\[::1\][:/]*) ;;
*) die "--base-url must be https:// (or http:// on localhost), got: $BASE_URL" ;;
esac
API="${BASE_URL%/}/v1/messages"

# The key is checked where a request can happen (one shot, chat loop), so
# `list` works without one.
need_key() { [ -n "${ANTHROPIC_API_KEY:-}" ] || die "no key: export ANTHROPIC_API_KEY"; }
command -v jq >/dev/null || die "jq not found"
case "$usage_max_tokens" in
"" | *[!0-9]* | 0*) die "--max-tokens must be a positive integer, got: $usage_max_tokens" ;;
esac

mkdir -p "$STATE" && chmod 700 "$STATE"
# The script writes fixed names next to HIST (.tmp, .turn, .sse, .container).
# In a directory other accounts can write, one of them could plant those
# names as symlinks or files. Refuse such a directory.
# shellcheck disable=SC2012  # ls -ldnL is portable to macOS; the path is ours, not user input
case "$(ls -ldnL "$STATE" | cut -c6,9)" in
*w*) die "$STATE is writable by other accounts; keep the history in a private directory" ;;
esac

# SAFE: prefix for every jq program that prints text to the terminal (the
# live printer has its own copy in lib/stream.jq). Replies and error messages
# may carry control characters; jq -r decodes \u001b etc. into raw bytes.
SAFE='def safe: if type == "string" then explode | map(select(. == 9 or . == 10 or (. >= 32 and . != 127 and (. < 128 or . > 159)))) | implode else . end; '

# A fresh history path; the PID keeps two processes started in the same second
# apart.
new_chat() {
  local f
  f="$STATE/$(date +%Y%m%dT%H%M%S)-$$.json"
  # /new in the same second would reuse the name and overwrite the chat
  while [ -e "$f" ]; do
    sleep 1
    f="$STATE/$(date +%Y%m%dT%H%M%S)-$$.json"
  done
  echo "$f"
}

# rollback_to <n>: keep the first n turns of the history (n >= 0)
rollback_to() { jq --argjson n "$(($1 < 0 ? 0 : $1))" '.[:$n]' "$HIST" >"$HIST.tmp" && mv "$HIST.tmp" "$HIST"; }

# skills_json: the container.skills array from -s ("" when not given), one
# typed entry per <skill_id>[@<version>] (lib/skills.jq)
skills_json() {
  [ -n "${usage_skills:-}" ] || {
    echo ""
    return
  }
  printf '%s' "$usage_skills" | tr ',' '\n' | jq -R -s -c -f "$LIB/skills.jq"
}

# show_history [file]: the chat as "you:" / "claude:" text (thinking blocks skipped)
show_history() {
  jq -r "$SAFE"'.[] | (if .role=="user" then "you" else "claude" end) as $who
        | (if (.content|type)=="string" then .content
           else [.content[] | select(.type=="text") | .text] | join("\n") end) as $t
        | "\($who): \($t)\n" | safe' "${1:-$HIST}"
}

# list_chats: chats on disk, newest first: name, turn count, the first
# prompt cut at 60 characters
list_chats() {
  # shellcheck disable=SC2012  # ls -t is the sort; names are ours, one per line
  ls -1t "$STATE"/*.json 2>/dev/null | while IFS= read -r f; do
    printf '%s  %s turns  %s\n' "$(basename "$f" .json)" "$(jq length "$f")" \
      "$(jq -r "$SAFE"'first(.[]|select(.role=="user"))|.content|if type=="string" then .[:60] else "" end | safe' "$f")"
  done
}

# find_chat [name-or-prefix]: the history file to resume, or exit 2. With no
# argument, the newest chat that has turns (empty files from aborted starts
# are skipped).
find_chat() {
  local f n=0 found=""
  if [ -n "${1:-}" ]; then
    # a chat name or prefix from `list`: no path parts or glob characters
    case "$1" in */* | *[*?[]*) die "resume takes a chat name from \`ask-claude list\`" ;; esac
    for f in "$STATE/$1"*.json; do
      [ -f "$f" ] || continue
      found="$f"
      n=$((n + 1))
    done
    [ "$n" -le 1 ] || die "\"$1\" matches $n chats, see \`ask-claude list\`"
  else
    # shellcheck disable=SC2012
    found=$(ls -1t "$STATE"/*.json 2>/dev/null | while IFS= read -r f; do
      [ "$(jq length "$f")" -gt 0 ] && {
        echo "$f"
        break
      }
    done)
  fi
  [ -n "$found" ] && [ -f "$found" ] || die "nothing to resume (see \`ask-claude list\`)"
  echo "$found"
}

# chat_loop: one turn per line until /quit; /new starts another chat,
# /history prints this one. On quit, prints the chat and the resume command;
# an empty chat leaves no file.
chat_loop() {
  local line
  echo "ask-claude: $usage_model, history $HIST  (/new resets, /quit exits)" >&2
  while IFS= read -r -e -p "> " line; do
    case "$line" in
    "") continue ;;
    /quit | /exit) break ;;
    /history)
      show_history
      continue
      ;;
    /new)
      [ "$(jq length "$HIST")" -gt 0 ] || rm -f "$HIST" "$HIST.container"
      HIST=$(new_chat)
      echo '[]' >"$HIST"
      echo "new chat: $HIST" >&2
      continue
      ;;
    esac
    ask "$line"
    echo
  done
  if [ "$(jq length "$HIST")" -eq 0 ]; then
    rm -f "$HIST" "$HIST.container"
    return 0
  fi
  echo
  echo "--- history ($HIST) ---" >&2
  show_history
  echo "resume with: ask-claude resume $(basename "$HIST" .json)" >&2
}

# transport: the request body on stdin, the raw SSE on stdout.
# ASK_CLAUDE_REPLAY=<file.sse> replays a recording instead of calling curl;
# ASK_CLAUDE_REQUEST_LOG=<file> appends each body that would have been sent.
# Neither the key nor the body goes on curl's command line, which other local
# accounts can read: the headers come from a pipe and the body from stdin.
transport() {
  if [ -n "${ASK_CLAUDE_REQUEST_LOG:-}" ]; then
    tee -a "$ASK_CLAUDE_REQUEST_LOG"
  else
    cat
  fi |
    if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
      cat "$ASK_CLAUDE_REPLAY"
    else
      curl -sS -N --max-time 1800 "$API" \
        -H @<(printf 'content-type: application/json\nx-api-key: %s\nanthropic-version: 2026-10-21\nanthropic-beta: %s\n' "$ANTHROPIC_API_KEY" "$betas") \
        --data-binary @-
    fi
}

# call: send the whole history as-is and append the reply. Prints the text
# blocks as they arrive, the usage line on stderr; returns 1 on API error
# with the history rolled back to before this ask. A pause_turn (server tool
# still working) is continued automatically, up to 8 rounds.
call() {
  local body resp err stop rounds=0 n0 log t0 skills cid
  n0=$(jq length "$HIST")
  # Skills run in Anthropic's code-execution sandbox, so -s also adds the
  # code_execution tool and its beta; the container id comes back in the
  # reply and is kept in $HIST.container so files persist across turns.
  skills=$(skills_json)
  betas="server-side-fallback-2026-07-01"
  [ -n "$skills" ] && betas="$betas,code-execution-2025-08-25"
  while :; do
    cid=""
    [ -n "$skills" ] && [ -s "$HIST.container" ] && cid=$(cat "$HIST.container")
    body=$(jq -n -c --arg m "$usage_model" --argjson max "$usage_max_tokens" \
      --arg sys "${usage_system:-}" --arg eff "${usage_effort:-}" \
      --arg skills "$skills" --arg cid "$cid" --slurpfile msgs "$HIST" -f "$LIB/request.jq")
    log="$HIST.sse" t0=$SECONDS
    : >"$log"
    # tee the raw SSE to $log, strip "data: " with builtins, print text live
    printf '%s\n' "$body" | transport |
      tee "$log" |
      while IFS= read -r l; do case "$l" in "data: "*) printf '%s\n' "${l#data: }" ;; esac done |
      jq --unbuffered -rj -f "$LIB/stream.jq"
    [ -s "$log" ] || {
      rm -f "$log"
      echo "ask-claude: no response (curl failed or timed out)" >&2
      rollback_to $((n0 - 1))
      return 1
    }
    if ! grep -q '^data: ' "$log"; then
      # not SSE: an HTTP error body
      err=$(jq -r "$SAFE"'.error.message // "unreadable response" | safe' "$log" 2>/dev/null || echo "unreadable response")
    elif ! resp=$(sed -n 's/^data: //p' "$log" | jq -s -f "$LIB/reassemble.jq"); then
      # a reply jq cannot fold is an error, not an empty turn that vanishes
      err="the reply could not be parsed"
    else
      err=$(printf '%s' "$resp" | jq -r "$SAFE"'.error.message // empty | safe')
    fi
    if [ -n "$err" ]; then
      rm -f "$log"
      echo "ask-claude: API error: $err" >&2
      # a container the API no longer accepts (expired, deleted) would fail
      # every later turn of this chat: forget it, the next turn starts a new one
      [ -n "$cid" ] && case "$err" in *[Cc]ontainer*) rm -f "$HIST.container" ;; esac
      rollback_to $((n0 - 1))
      return 1
    fi
    # keep the full content array (thinking blocks included) for the next turn
    printf '%s' "$resp" | jq '{role:"assistant", content:.content}' >"$HIST.turn"
    jq --slurpfile t "$HIST.turn" '. + $t' "$HIST" >"$HIST.tmp" && mv "$HIST.tmp" "$HIST" && rm -f "$HIST.turn"
    printf '%s' "$resp" | jq -r '.container.id // empty' >"$HIST.container.tmp"
    if [ -s "$HIST.container.tmp" ]; then mv "$HIST.container.tmp" "$HIST.container"; else rm -f "$HIST.container.tmp"; fi
    rm -f "$log"
    stop=$(printf '%s' "$resp" | jq -r "$SAFE"'.stop_reason | safe')
    printf '%s' "$resp" | jq -r --argjson s $((SECONDS - t0)) "$SAFE"'"[\(.model) in=\(.usage.input_tokens) cache_read=\(.usage.cache_read_input_tokens // 0) cache_write=\(.usage.cache_creation_input_tokens // 0) out=\(.usage.output_tokens) \($s)s]" | safe' >&2
    if [ "$stop" = "pause_turn" ] && [ $rounds -lt 8 ]; then
      rounds=$((rounds + 1))
      echo "[pause_turn: continuing, round $rounds]" >&2
      continue
    fi
    break
  done
  case "$stop" in
  end_turn) ;;
  refusal) echo "[stopped: refusal $(printf '%s' "$resp" | jq -r "$SAFE"'.stop_details.category // "" | safe')]" >&2 ;;
  max_tokens) echo "[stopped: max_tokens reached, raise --max-tokens]" >&2 ;;
  *) echo "[stopped: $stop]" >&2 ;;
  esac
}

# ask <text>: append a user turn, then call
ask() {
  jq --arg c "$1" '. + [{"role":"user","content":$c}]' "$HIST" >"$HIST.tmp" && mv "$HIST.tmp" "$HIST"
  call
}

# ---- Managed Agents sessions (docs/plans/2026-11-05-001) ----------------
# A session's transcript lives on the API; the state dir keeps one small file
# per session under sessions/ so `list` and `resume` know what this machine
# started. One turn is: send events, open the stream, print until the first
# session.status_idle, fold the stream, answer what the session waits on.
SESSIONS="$STATE/sessions"
MA_BETA="managed-agents-2026-04-01"
turn=0

ma_headers() { printf 'content-type: application/json\nx-api-key: %s\nanthropic-version: 2026-10-21\nanthropic-beta: %s\n' "$ANTHROPIC_API_KEY" "$MA_BETA"; }

# ma_call <method> <path> [body]: one request, the response body on stdout.
# Replay: the body is logged and a canned response stands in for the API.
ma_call() {
  local method=$1 path=$2 body=${3:-}
  [ -z "${ASK_CLAUDE_REQUEST_LOG:-}" ] || [ -z "$body" ] || printf '%s\n' "$body" >>"$ASK_CLAUDE_REQUEST_LOG"
  if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
    case "$method $path" in
    "POST /sessions") echo '{"id":"sesn_FIXTURE01","status":"running"}' ;;
    "GET /sessions/"*"/events"*) cat "$ASK_CLAUDE_REPLAY/events.json" 2>/dev/null || echo '{"data":[]}' ;;
    "GET /sessions"*) cat "$ASK_CLAUDE_REPLAY/sessions.json" 2>/dev/null || echo '{"data":[]}' ;;
    *) echo '{}' ;;
    esac
    return 0
  fi
  if [ -n "$body" ]; then
    printf '%s' "$body" | curl -sS -X "$method" "$BASE_URL/v1$path" -H @<(ma_headers) --data-binary @-
  else
    curl -sS -X "$method" "$BASE_URL/v1$path" -H @<(ma_headers)
  fi
}

# session_stream <sesn>: the raw SSE of one turn on stdout, stopped after the
# first idle or termination (sed quits, curl gets the closed pipe). Replay:
# the fixture file, or the Nth file of a fixture directory for the Nth turn.
session_stream() {
  if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
    if [ -d "$ASK_CLAUDE_REPLAY" ]; then cat "$ASK_CLAUDE_REPLAY/$turn.sse"; else cat "$ASK_CLAUDE_REPLAY"; fi
    return 0
  fi
  curl -sS -N --max-time 1800 "$BASE_URL/v1/sessions/$1/events/stream" -H @<(ma_headers) 2>/dev/null |
    sed -u '/"type":"session.status_idle"/q;/"type":"session.status_terminated"/q'
}

# session_answer <fold>: the events that answer what the session waits on.
# A tool confirmation is asked at the terminal (y / n / a for the rest of
# this process) and denied when there is none; ASK_CLAUDE_CONFIRM=allow|deny
# answers without asking. A custom tool call gets an error result, since
# nothing runs here yet.
session_always=""
session_tty=""      # set per answer round, outside the loop that redirects stdin
session_confirm() { # <name> <input>: allow | deny
  local answer
  case "${ASK_CLAUDE_CONFIRM:-ask}" in
  allow)
    echo allow
    return
    ;;
  deny)
    echo deny
    return
    ;;
  esac
  [ -n "$session_always" ] && {
    echo allow
    return
  }
  if [ -z "$session_tty" ] || [ ! -r /dev/tty ]; then
    echo "ask-claude: denied $1 ($2): stdin is not a terminal (ASK_CLAUDE_CONFIRM=allow to allow unattended)" >&2
    echo deny
    return
  fi
  IFS= read -r -p "allow $1 $2? [y/N/a(lways)] " answer </dev/tty || answer=""
  case "$answer" in
  y | Y | yes) echo allow ;;
  a | A | always)
    session_always=1
    echo allow
    ;;
  *) echo deny ;;
  esac
}
session_answer() {
  local fold=$1 answers="[]" id name input result
  if [ -t 0 ]; then session_tty=1; else session_tty=""; fi
  while IFS=$'\t' read -r id name input; do
    [ -n "$id" ] || continue
    result=$(session_confirm "$name" "$input")
    [ "$result" = allow ] && echo "ask-claude: allowed $name ($input)" >&2
    [ "$result" = deny ] && [ -n "${ASK_CLAUDE_CONFIRM:-}" ] && echo "ask-claude: denied $name ($input): ASK_CLAUDE_CONFIRM=$ASK_CLAUDE_CONFIRM" >&2
    answers=$(jq -c --arg id "$id" --arg r "$result" '. + [{type: "user.tool_confirmation", tool_use_id: $id, result: $r}]' <<<"$answers")
  done < <(jq -r '.asks[] | [.id, .name, (.input | tostring)] | @tsv' <<<"$fold")
  jq -c --argjson a "$answers" --arg msg "Tool unavailable: ask-claude $ASK_CLAUDE_VERSION runs no local tools (see docs/plan.md). Do not call it again; answer the user without it." '
    {events: ($a + [.custom[] | {type: "user.custom_tool_result", custom_tool_use_id: .id,
                                 content: [{type: "text", text: $msg}], is_error: true}])}' <<<"$fold"
}

# session_turn <sesn> [events]: one user turn, however many streams it takes.
# Prints the reply as it arrives and the usage line on stderr; returns 1 on a
# session error.
session_turn() {
  local sesn=$1 events=${2:-} log fold err stop rounds=0 t0=$SECONDS
  while :; do
    [ -z "$events" ] || ma_call POST "/sessions/$sesn/events" "$events" >/dev/null
    turn=$((turn + 1)) # here, not in session_stream: a pipeline runs in a subshell
    log="$STATE/.stream.$$"
    : >"$log"
    session_stream "$sesn" |
      tee "$log" |
      while IFS= read -r l; do case "$l" in "data: "*) printf '%s\n' "${l#data: }" ;; esac done |
      jq --unbuffered -rj -f "$LIB/session.jq"
    fold=$(sed -n 's/^data: //p' "$log" | jq -s -c -f "$LIB/session-fold.jq")
    rm -f "$log"
    err=$(jq -r "$SAFE"'.error.message // empty | safe' <<<"$fold")
    if [ -n "$err" ]; then
      echo "ask-claude: session error: $err" >&2
      return 1
    fi
    stop=$(jq -r '.stop_reason // ""' <<<"$fold")
    if [ "$stop" = requires_action ] && [ $rounds -lt 8 ]; then
      rounds=$((rounds + 1))
      events=$(session_answer "$fold")
      continue
    fi
    break
  done
  jq -r --arg s "$sesn" --argjson t $((SECONDS - t0)) "$SAFE"'.usage
    | "[\($s) in=\(.input_tokens) out=\(.output_tokens) cache_read=\(.cache_read) cache_write=\(.cache_write) cost=$\((.list_cost | tonumber) / 100 | . * 100 | round / 100 | tostring | if test("\\.") then (. + "00" | capture("(?<d>[0-9]+\\.[0-9]{2})").d) else . + ".00" end) \($t)s]" | safe' <<<"$fold" >&2
  case "$stop" in
  end_turn | "") ;;
  requires_action)
    echo "[stopped: requires_action after $rounds rounds; interrupting]" >&2
    ma_call POST "/sessions/$sesn/events" '{"events":[{"type":"user.interrupt"}]}' >/dev/null
    ;;
  budget_reached) echo "[stopped: budget_reached, raise it with: ask-claude agent budget $sesn <cents>]" >&2 ;;
  *) echo "[stopped: $stop]" >&2 ;;
  esac
}

# session_create <prompt>: POST /v1/sessions with the prompt as the first
# event; prints the new session id, or an API error and returns 1.
session_create() {
  local body resp sesn err
  body=$(jq -n -c --arg agent "$usage_agent" --arg env "$usage_environment" --arg budget "$usage_budget" --arg file "${session_file_id:-}" --arg file_name "$(basename "${usage_file:-}")" \
    --arg title "" --arg prompt "$1" -f "$LIB/session-create.jq")
  resp=$(ma_call POST /sessions "$body")
  sesn=$(jq -r '.id // empty' <<<"$resp" 2>/dev/null)
  if [ -z "$sesn" ]; then
    err=$(jq -r "$SAFE"'.error.message // "unreadable response" | safe' <<<"$resp" 2>/dev/null || echo "unreadable response")
    echo "ask-claude: API error: $err" >&2
    return 1
  fi
  echo "$sesn"
}

# session_remember <sesn>: the state file `list` and `resume` read
session_remember() {
  mkdir -p "$SESSIONS"
  printf 'agent=%s\nenvironment=%s\ncreated=%s\n' "$usage_agent" "$usage_environment" "$(date +%Y%m%dT%H%M%S)" >"$SESSIONS/$1"
}

# session_find <id-or-prefix>: a session id, from sessions/ by prefix, or the
# id itself when it looks like one; exit 2 otherwise
session_find() {
  local f n=0 found=""
  case "$1" in */* | *[*?[]*) die "resume takes a session id or a prefix from \`ask-claude agent list\`" ;; esac
  for f in "$SESSIONS/$1"* "$SESSIONS/sesn_$1"*; do
    [ -f "$f" ] || continue
    found="${f##*/}"
    n=$((n + 1))
  done
  if [ "$n" -gt 1 ]; then
    die "\"$1\" matches $n sessions, see \`ask-claude agent list\`"
  elif [ "$n" -eq 1 ]; then
    echo "$found"
  elif [[ $1 == sesn_* ]]; then
    echo "$1"
  else
    die "nothing to resume: \"$1\" is not a session id, nor a prefix of one started here"
  fi
}

# session_history <sesn>: the session's messages so far, from the API
session_history() {
  ma_call GET "/sessions/$1/events?types[]=user.message&types[]=agent.message" | jq -r -f "$LIB/session-history.jq"
}

# session_list: the API's sessions, newest first
session_list() {
  ma_call GET "/sessions?order=desc&limit=50" | jq -r "$SAFE"'.data[]? | [.id, .status,
    ("$" + ((.usage.list_cost.amount // "0" | tonumber) / 100 | tostring | if test("\\.") then (. + "00" | capture("(?<d>[0-9]+\\.[0-9]{2})").d) else . + ".00" end)),
    (.title // "")] | join("  ") | safe'
}

# session_loop [sesn]: one turn per line until /quit. With no session yet,
# the first line creates one (so quitting first leaves nothing); /new drops
# the current one and the next line creates another; /history prints the
# session so far.
session_loop() {
  local sesn=${1:-} line
  echo "ask-claude: agent $usage_agent  (/new starts another session, /quit exits)" >&2
  while IFS= read -r -e -p "> " line; do
    case "$line" in
    "") continue ;;
    /quit | /exit) break ;;
    /history)
      [ -n "$sesn" ] && session_history "$sesn"
      continue
      ;;
    /new)
      sesn=""
      echo "new session on the next line" >&2
      continue
      ;;
    esac
    if [ -z "$sesn" ]; then
      sesn=$(session_create "$line") || continue
      session_turn "$sesn" && session_remember "$sesn"
    else
      session_turn "$sesn" "$(jq -n -c --arg t "$line" '{events: [{type: "user.message", content: [{type: "text", text: $t}]}]}')"
    fi
    echo
  done
  [ -z "$sesn" ] || echo "resume with: ask-claude agent resume $sesn" >&2
}

# file_upload <path>: POST /v1/files (multipart, no beta header: the Files
# API is out of beta); prints the file id. Replay logs {"file": name}.
file_upload() {
  local resp id name
  name=$(basename "$1")
  if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
    [ -z "${ASK_CLAUDE_REQUEST_LOG:-}" ] || jq -n -c --arg f "$name" '{file: $f}' >>"$ASK_CLAUDE_REQUEST_LOG"
    echo file_FIXTURE01
    return 0
  fi
  resp=$(curl -sS "$BASE_URL/v1/files" -H @<(printf 'x-api-key: %s\nanthropic-version: 2026-10-21\n' "$ANTHROPIC_API_KEY") -F "file=@$1")
  id=$(jq -r '.id // empty' <<<"$resp" 2>/dev/null)
  if [ -z "$id" ]; then
    echo "ask-claude: upload failed: $(jq -r "$SAFE"'.error.message // "unreadable response" | safe' <<<"$resp" 2>/dev/null || echo "unreadable response")" >&2
    return 1
  fi
  echo "$id"
}

# session_files <sesn> [name]...: the files a session holds (uploads and what
# the agent wrote to /mnt/session/outputs), or download the named ones into
# the current directory
session_files() {
  local sesn=$1 page name id size n
  shift
  if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
    page=$(cat "$ASK_CLAUDE_REPLAY/files.json" 2>/dev/null || echo '{"data":[]}')
  else
    page=$(curl -sS "$BASE_URL/v1/files?scope_id=$sesn" -H @<(ma_headers))
  fi
  if [ $# -eq 0 ]; then
    jq -r "$SAFE"'.data[]? | [.filename, (.size_bytes | tostring), .id] | @tsv | safe' <<<"$page" | column -t -s $'\t'
    return 0
  fi
  for name in "$@"; do
    case "$name" in */* | "" | .*) die "files takes names from \`ask-claude agent files $sesn\`, not paths" ;; esac
    n=$(jq -r --arg n "$name" '[.data[]? | select(.filename == $n)] | length' <<<"$page")
    [ "$n" -gt 0 ] || die "the session has no file named $name"
    id=$(jq -r --arg n "$name" 'last(.data[]? | select(.filename == $n)) | .id' <<<"$page")
    if [ -e "$name" ] && [ "${usage_force:-}" != true ]; then
      die "$name exists here; --force overwrites it"
    fi
    if [ -n "${ASK_CLAUDE_REPLAY:-}" ]; then
      cat "$ASK_CLAUDE_REPLAY/files/$name" >"$name.part"
    else
      curl -sS "$BASE_URL/v1/files/$id/content" -H @<(ma_headers) -o "$name.part"
    fi
    mv "$name.part" "$name"
    size=$(wc -c <"$name")
    echo "ask-claude: wrote $name ($size bytes)" >&2
  done
}

# session_prereqs: what every agent form needs before a request can happen
session_prereqs() {
  [ -n "${usage_agent:-}" ] || die "no agent id: --agent or ASK_CLAUDE_AGENT (the Console, Agents)"
  [ -n "${usage_environment:-}" ] || die "no environment id: --environment or ASK_CLAUDE_ENVIRONMENT (the Console, Environments)"
  case "${usage_budget:-}" in
  "" | *[!0-9]*) die "--budget must be whole cents, 0 for none, got: ${usage_budget:-}" ;;
  esac
  case "${ASK_CLAUDE_CONFIRM:-ask}" in
  ask | allow | deny) ;;
  *) die "ASK_CLAUDE_CONFIRM must be ask, allow or deny, got: $ASK_CLAUDE_CONFIRM" ;;
  esac
  [ -z "${usage_file:-}" ] || [ -r "$usage_file" ] || die "cannot read $usage_file"
  need_key
}

case "${usage_cmd:-}" in
agent)
  session_prereqs
  session_file_id=""
  if [ -n "${usage_file:-}" ]; then session_file_id=$(file_upload "$usage_file") || exit 1; fi
  if [ -z "${usage_prompt:-}" ]; then
    session_loop
    exit 0
  fi
  sesn=$(session_create "$usage_prompt") || exit 1
  if session_turn "$sesn"; then
    session_remember "$sesn"
    exit 0
  fi
  rm -f "$SESSIONS/$sesn"
  exit 1
  ;;
"agent files")
  need_key
  # shellcheck disable=SC2086  # usage_name is the space-joined list usage builds
  session_files "$usage_session" ${usage_name:-}
  exit 0
  ;;
"agent list")
  need_key
  session_list
  exit 0
  ;;
"agent resume")
  sesn=$(session_find "$usage_session") || exit 2
  session_prereqs
  echo "resuming $sesn" >&2
  session_history "$sesn" >&2
  session_loop "$sesn"
  exit 0
  ;;
list)
  list_chats
  exit 0
  ;;
resume)
  HIST=$(find_chat "${usage_chat:-}") || exit 2
  need_key
  echo "resuming $HIST" >&2
  show_history >&2
  chat_loop
  exit $?
  ;;
esac

# no prompt: the chat loop
if [ -z "${usage_prompt:-}" ]; then
  need_key
  HIST=$(new_chat)
  echo '[]' >"$HIST"
  chat_loop
  exit $?
fi

# one shot: optional -f FILE, then the prompt
need_key
prefix=""
if [ -n "${usage_file:-}" ]; then
  [ -r "$usage_file" ] || die "cannot read $usage_file"
  prefix="$(cat "$usage_file")"$'\n\n'
fi
HIST="$(new_chat)"
echo '[]' >"$HIST"
ask "$prefix$usage_prompt"
rc=$?
# an empty chat leaves no file
[ "$(jq length "$HIST")" -gt 0 ] || rm -f "$HIST"
exit $rc
